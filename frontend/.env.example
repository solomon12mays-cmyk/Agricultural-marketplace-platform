# Copy to .env (or .env.local) and adjust for your environment.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Base URL of the backend API. The dev server proxies /api to localhost:8081.
VITE_API_BASE_URL=/api/v1

# Application display name shown in the header and document title.
VITE_APP_NAME=Agricultural Marketplace
