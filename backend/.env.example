# Copy to .env at the repository root and fill in real values.
# Never commit the real .env file.

# PostgreSQL (used by docker-compose.yml)
POSTGRES_DB=agri_marketplace
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
# Operator bootstrap account seeded on first startup
APP_AUTH_OPERATOR_USERNAME=operator
APP_AUTH_OPERATOR_PASSWORD=use-a-unique-password-of-at-least-10-characters

# Session cookie security; set to true when serving over HTTPS
APP_SESSION_COOKIE_SECURE=false

# JWT validation (JWK Set endpoint of your identity provider)
JWT_JWK_SET_URI=

# AES key for encrypting organization owner identity data (Base64, 32 random bytes)
# Generate with: openssl rand -base64 32
ORG_DATA_ENCRYPTION_KEY=
ORG_DATA_ENCRYPTION_KEY_ID=local-v1

# Encrypt farmer identity and payout account numbers at rest (Base64 AES key)
APP_PII_ENCRYPTION_KEY=
APP_PII_ENCRYPTION_KEY_ID=local-v1

# Shared secret required on inbound telecom USSD callbacks
USSD_CALLBACK_TOKEN=

# Allowed CORS origins for local frontend development
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
